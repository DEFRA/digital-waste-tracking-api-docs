<mxfile host="Electron" agent="Claude Code">
  <diagram name="DWT Operational and Service Layers" id="dwt-movement-transfer-events">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer boundary -->
        <mxCell id="outer" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 2;fillColor=none;strokeColor=#000000;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="860" width="860" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="opTitle" parent="1" style="text;html=1;fontSize=16;fontStyle=5;align=center;verticalAlign=middle;fontColor=#000000;" value="OPERATIONAL LAYER" vertex="1">
          <mxGeometry height="26" width="300" x="300" y="42" as="geometry" />
        </mxCell>

        <!-- Colour blobs (behind boxes) - equal size (460x210 pre-rotation), each fitted to fully
             enclose its operational-layer box and its matching service-layer event box -->
        <mxCell id="blobGreen" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A8D5A2;strokeColor=none;opacity=45;rotation=54;" value="" vertex="1">
          <mxGeometry height="210" width="460" x="-45" y="125" as="geometry" />
        </mxCell>
        <mxCell id="blobBlue" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9FC2E8;strokeColor=none;opacity=45;rotation=-48;" value="" vertex="1">
          <mxGeometry height="210" width="460" x="470" y="125" as="geometry" />
        </mxCell>
        <mxCell id="blobPurple" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C7B3E0;strokeColor=none;opacity=45;rotation=48;" value="" vertex="1">
          <mxGeometry height="210" width="460" x="470" y="565" as="geometry" />
        </mxCell>
        <mxCell id="blobYellow" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5E08A;strokeColor=none;opacity=45;rotation=-54;" value="" vertex="1">
          <mxGeometry height="210" width="460" x="-45" y="565" as="geometry" />
        </mxCell>

        <!-- Operational layer boxes -->
        <mxCell id="opArrange" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" value="Arrange Waste Movement" vertex="1">
          <mxGeometry height="90" width="110" x="60" y="90" as="geometry" />
        </mxCell>
        <mxCell id="opCollect" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" value="Collect Waste" vertex="1">
          <mxGeometry height="90" width="110" x="730" y="90" as="geometry" />
        </mxCell>
        <mxCell id="opDropoff" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" value="Drop off Waste" vertex="1">
          <mxGeometry height="90" width="110" x="730" y="720" as="geometry" />
        </mxCell>
        <mxCell id="opReceive" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" value="Receive Waste" vertex="1">
          <mxGeometry height="90" width="110" x="60" y="720" as="geometry" />
        </mxCell>

        <!-- Operational flow arrows -->
        <mxCell id="opA1" edge="1" parent="1" source="opArrange" target="opCollect" style="html=1;endArrow=classic;startArrow=none;strokeColor=#999999;strokeWidth=4;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="opA2" edge="1" parent="1" source="opCollect" target="opDropoff" style="html=1;endArrow=classic;startArrow=none;strokeColor=#999999;strokeWidth=4;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="opA3" edge="1" parent="1" source="opDropoff" target="opReceive" style="html=1;endArrow=classic;startArrow=none;strokeColor=#999999;strokeWidth=4;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Service layer boundary -->
        <mxCell id="svcBoundary" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 2;fillColor=none;strokeColor=#000000;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="450" width="590" x="155" y="225" as="geometry" />
        </mxCell>
        <mxCell id="svcTitle" parent="1" style="text;html=1;fontSize=16;fontStyle=5;align=center;verticalAlign=middle;fontColor=#000000;" value="SERVICE LAYER" vertex="1">
          <mxGeometry height="26" width="300" x="290" y="238" as="geometry" />
        </mxCell>

        <!-- Event notes -->
        <mxCell id="evtCreation" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;size=14;fontSize=12;" value="CREATION EVENT" vertex="1">
          <mxGeometry height="90" width="130" x="190" y="280" as="geometry" />
        </mxCell>
        <mxCell id="evtCollection" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;size=14;fontSize=12;" value="COLLECTION EVENT" vertex="1">
          <mxGeometry height="90" width="130" x="550" y="280" as="geometry" />
        </mxCell>
        <mxCell id="evtReceipt" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;size=14;fontSize=12;" value="RECEIPT EVENT" vertex="1">
          <mxGeometry height="90" width="130" x="190" y="530" as="geometry" />
        </mxCell>
        <mxCell id="evtDropoff" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;size=14;fontSize=12;" value="DROP OFF EVENT" vertex="1">
          <mxGeometry height="90" width="130" x="550" y="530" as="geometry" />
        </mxCell>

        <!-- ID circles -->
        <mxCell id="idMovement" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontColor=#1D3557;fontStyle=1;fontSize=12;" value="Movement ID" vertex="1">
          <mxGeometry height="110" width="110" x="395" y="350" as="geometry" />
        </mxCell>
        <mxCell id="idTransfer" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontColor=#1D3557;fontStyle=1;fontSize=12;" value="Transfer ID" vertex="1">
          <mxGeometry height="110" width="110" x="395" y="500" as="geometry" />
        </mxCell>

        <!-- ER relationships -->
        <mxCell id="relA" edge="1" parent="1" source="evtCreation" target="idMovement" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=ERone;endArrow=ERone;startFill=1;endFill=1;strokeColor=#000000;fontColor=#B36B00;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value="[creates]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="relB" edge="1" parent="1" source="idMovement" target="evtCollection" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=ERone;endArrow=ERzeroToOne;startFill=1;endFill=1;strokeColor=#000000;fontColor=#B36B00;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="[assigned to]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="relC" edge="1" parent="1" source="idTransfer" target="idMovement" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;endArrow=classic;strokeColor=#000000;fontColor=#B36B00;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="[relates to]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="relD" edge="1" parent="1" source="idTransfer" target="evtDropoff" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=ERone;endArrow=ERone;startFill=1;endFill=1;strokeColor=#000000;fontColor=#B36B00;fontSize=11;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="[creates]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="relE" edge="1" parent="1" source="evtReceipt" target="idTransfer" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=ERzeroToOne;endArrow=ERone;startFill=1;endFill=1;strokeColor=#000000;fontColor=#B36B00;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" value="[assigned to]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
