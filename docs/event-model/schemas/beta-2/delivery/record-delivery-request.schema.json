{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Record delivery request",
  "description": "Payload for POST /beta-2/deliveries.",
  "type": "object",
  "properties": {
    "movementIds": {
      "type": "array",
      "items": {
        "$ref": "../common/movement-id.schema.json"
      },
      "minItems": 1,
      "description": "One or more Movement IDs delivered together at this delivery."
    },
    "carrier": {
      "$ref": "../common/carrier.schema.json"
    },
    "supportingReferences": {
      "$ref": "../common/supporting-references.schema.json"
    }
  },
  "required": ["movementIds", "carrier"],
  "additionalProperties": false
}
