{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Create collection request",
  "description": "Payload for POST /beta-2/movements/{movementId}/collection.",
  "type": "object",
  "properties": {
    "carrier": {
      "$ref": "../common/carrier.schema.json"
    },
    "brokerOrDealer": {
      "$ref": "../common/broker-or-dealer/broker-or-dealer.schema.json"
    },
    "dutyOfCareConfirmed": {
      "type": "boolean",
      "description": "Carrier confirms they have inspected the waste, that it is as described, and that they are content to transport it."
    },
    "supportingReferences": {
      "$ref": "../common/supporting-references.schema.json"
    },
    "specialHandlingRequirements": {
      "$ref": "../common/special-handling-requirements.schema.json"
    }
  },
  "required": ["carrier", "dutyOfCareConfirmed"],
  "additionalProperties": false
}
