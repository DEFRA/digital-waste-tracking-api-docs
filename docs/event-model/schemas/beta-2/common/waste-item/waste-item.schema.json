{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Waste item",
  "description": "A single item of waste in a movement. physicalDetails is required.",
  "examples": [
    {
      "physicalDetails": {
        "form": "SOLID",
        "containerType": "DRU",
        "containerCount": 4,
        "totalWeight": {
          "amount": 250.5,
          "unit": "KILOGRAMS",
          "isEstimate": false
        }
      }
    },
    {
      "physicalDetails": {
        "form": "MIXED",
        "containerType": "LOO",
        "containerCount": 0,
        "totalWeight": {
          "amount": 2,
          "unit": "TONNES",
          "isEstimate": true
        }
      }
    }
  ],
  "type": "object",
  "properties": {
    "physicalDetails": {
      "$ref": "physical-details.schema.json",
      "description": "The physical form, containers and total weight of the waste item."
    }
  },
  "required": ["physicalDetails"],
  "additionalProperties": false
}
