{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Producer (Municipal)",
  "description": "Producer fields specific to municipal waste. organisationName, address and contactDetails are required; sicCode is optional. Exactly one of authorisationNumber or reasonForNoAuthorisationNumber must be provided.",
  "type": "object",
  "allOf": [
    { "$ref": "producer-base.schema.json" },
    {
      "type": "object",
      "oneOf": [
        {
          "required": ["authorisationNumber"],
          "properties": {
            "authorisationNumber": {},
            "reasonForNoAuthorisationNumber": false
          }
        },
        {
          "required": ["reasonForNoAuthorisationNumber"],
          "properties": {
            "authorisationNumber": false,
            "reasonForNoAuthorisationNumber": {}
          }
        }
      ],
      "properties": {
        "wasteSource": {
          "const": "Municipal",
          "description": "Waste originates from a municipal source."
        },
        "organisationName": {
          "type": "string",
          "minLength": 1,
          "description": "Producer organisation name."
        },
        "authorisationNumber": {
          "type": "string",
          "pattern": "^\\s*(?:(?:[A-Za-z]{2}\\d{4}[A-Za-z]{2})|(?:[A-Za-z]{2}\\d{4}[A-Za-z]{2}\\/[Dd]\\d{4,5})|(?:[Ee][Pp][Rr]\\/[A-Za-z]{2}\\d{4}[A-Za-z]{2})|(?:[Ee][Pp][Rr]\\/[A-Za-z]{2}\\d{4}[A-Za-z]{2}\\/[Dd]\\d{4,5})|(?:[Ee][Aa][Ww][Mm][Ll]\\d{5,6})|(?:[Ww][Mm][Ll]\\d{5,6})|(?:[Pp][Pp][Cc]\\/[AaWwEeNn]\\/\\d{7})|(?:[Ww][Mm][Ll]\\/[LlWwEeNn]\\/\\d{7})|(?:[Ww][Mm][Ll]\\/[LlWwEeNn]\\/\\d{7}\\/\\d{2})|(?:[Pp][Pp][Cc]\\/[Aa]\\/[Ss][Ee][Pp][Aa]\\d{4}-\\d{4})|(?:[Ww][Mm][Ll]\\/[Ll]\\/[Ss][Ee][Pp][Aa]\\d{4}-\\d{4})|(?:[Ee][Aa][Ss]\\/[Pp]\\/\\d{6})|(?:[Pp]\\d{4}\\/\\d{2}[A-Za-z])|(?:[Pp]\\d{4}\\/\\d{2}[A-Za-z]\\/[Vv]\\d+)|(?:[Ww][Pp][Pp][Cc] \\d{2}\\/\\d{2})|(?:[Ww][Pp][Pp][Cc] \\d{2}\\/\\d{2}\\/[Vv]\\d+)|(?:[Ww][Mm][Ll] \\d{2}\\/\\d+(\\/[Tt])? [Ll][Nn]\\/\\d{2}\\/\\d+(\\/([MmTtCcNn]|[Vv]\\d+))*)|(?:[Ww][Mm][Ll] \\d{2}\\/\\d+ [Pp][Aa][Cc]\\/\\d{4}\\/[Ww][Cc][Ll]\\d{3}))\\s*$",
          "description": "Producer environmental permit or exemption number, in a valid UK format. Mutually exclusive with reasonForNoAuthorisationNumber — exactly one of the two is required."
        },
        "reasonForNoAuthorisationNumber": {
          "type": "string",
          "description": "Reason no authorisationNumber is held. Free text for now — enum values TBC pending BA/policy input. Mutually exclusive with authorisationNumber — exactly one of the two is required."
        },
        "sicCode": {
          "type": "string",
          "pattern": "^\\d{5}$",
          "description": "Five-digit Standard Industrial Classification code."
        },
        "contactDetails": {
          "$ref": "../contact-details.schema.json"
        },
        "address": {
          "$ref": "../address.schema.json"
        }
      },
      "required": [
        "wasteSource",
        "organisationName",
        "address",
        "contactDetails"
      ]
    }
  ],
  "propertyNames": {
    "enum": [
      "wasteSource",
      "organisationName",
      "authorisationNumber",
      "reasonForNoAuthorisationNumber",
      "sicCode",
      "contactDetails",
      "address",
      "councilMovement"
    ]
  }
}
